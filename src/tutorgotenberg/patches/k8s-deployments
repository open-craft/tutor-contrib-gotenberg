---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: gotenberg
  labels:
    app.kubernetes.io/name: gotenberg
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: gotenberg
  template:
    metadata:
      labels:
        app.kubernetes.io/name: gotenberg
    spec:
      containers:
        - name: gotenberg
          image: {{ GOTENBERG_DOCKER_IMAGE }}
          ports:
            - containerPort: 3000
          securityContext:
            privileged: false
            runAsUser: 1001
